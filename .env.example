# Django core
DJANGO_SECRET_KEY=replace-with-a-strong-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=.up.railway.app,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app-name.up.railway.app
DJANGO_TIME_ZONE=UTC

# Database (Railway Postgres plugin auto-provides this)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional Redis/Celery
CELERY_BROKER_URL=redis://default:password@host:6379/0
CELERY_RESULT_BACKEND=redis://default:password@host:6379/1

# Optional S3 storage
USE_S3=0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

# Optional email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
